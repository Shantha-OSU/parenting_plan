# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=3000
NODE_ENV=development
OPEN_BROWSER_ON_START=true

# MongoDB connection string (matches docker-compose.yml credentials)
MONGODB_URI=mongodb://admin:password123@localhost:27017/parenting_db?authSource=admin

# Session secret for express-session (change in production)
SESSION_SECRET=replace-with-a-long-random-secret

# Firebase Web App config (safe to expose to browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin credentials (choose one method)
# 1) Path to downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# 2) Or full JSON in one env var (optional alternative)
# FIREBASE_SERVICE_ACCOUNT_JSON=
